generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id          Int         @id @default(autoincrement())
  pro_img     String      @default("000")
  name        String      @default("")
  email       String      @unique
  password    String
  credit      Int         @default(0)
  rep         Int         @default(0)
  rep_motion_url String @default("")
  badge_list  Json?   
  noob Boolean @default(true)
  my_poketmon have_poke[]
  my_posts    posts[]
  like_post like_post[]
  followers      follow_table[] @relation("followersRelation")
  following      follow_table[] @relation("followingRelation")
}

model poke_table {
  id         Int     @id
  en_name    String? @db.VarChar(20)
  ko_name    String? @db.VarChar(20)
  en_type    String? @db.VarChar(100)
  ko_type    String? @db.VarChar(100)
  card_url   String? @db.VarChar(200)
  motion_url String? @db.VarChar(200)
  stats      Json?
  credit     Int     @default(0)
  have_poke have_poke[]
}

model follow_table {
  id           Int   @id @default(autoincrement())
  follower_id  Int
  following_id Int
  follower     user  @relation("followingRelation", fields: [follower_id], references: [id], onDelete: Cascade)
  following    user  @relation("followersRelation", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([follower_id], map: "follow_table_follower_id_fkey")
  @@index([following_id], map: "follow_table_following_id_fkey")
}

model have_poke {
  id      Int   @id @default(autoincrement())
  poke_id Int
  user_id Int
  author  user   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  poke poke_table @relation(fields: [poke_id], references: [id])

  @@index([user_id], map: "have_poke_user_id_fkey")
  
}

model posts {
  id         Int      @id @unique @default(autoincrement())
  user_id    Int
  content    String
  date       DateTime @default(now())
  like_count Int      @default(0)
  author     user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  like_post like_post[] 
  @@index([user_id], map: "list_table_user_id_fkey")
}

model like_post {
  id      Int    @id @default(autoincrement())
  user_id Int
  post_id Int
  user    user   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post    posts  @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
}
model favorite_table {
  id            Int    @id @unique
  favorite_list String @db.VarChar(2000)
}
